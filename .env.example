# Copy to .env.local (git-ignored) and fill in only what you need. Never commit real keys.
#
# With nothing set, the app uses Open-Meteo: real weather, free, no account and no key.

# Optional. An OpenWeather key with the "One Call API 3.0" subscription. When set, the app uses
# OpenWeather instead of Open-Meteo. Set a daily call cap on the OpenWeather account: this key
# ships inside the app bundle.
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# Optional. Force a provider: open-meteo, openweather, or fake (deterministic test weather).
EXPO_PUBLIC_WEATHER_PROVIDER=

# Optional. Older switch for the fake provider; EXPO_PUBLIC_WEATHER_PROVIDER=fake does the same.
EXPO_PUBLIC_USE_FAKE_PROVIDER=
